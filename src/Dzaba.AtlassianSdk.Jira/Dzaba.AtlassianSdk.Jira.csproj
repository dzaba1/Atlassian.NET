<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;netstandard2.0</TargetFrameworks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591,NU1903</WarningsNotAsErrors>
    <PackageId>Dzaba.AtlassianSDK</PackageId>
    <Authors>dzaba1</Authors>
    <Product>Atlassian.SDK</Product>
    <Copyright>https://bitbucket.org/farmas/atlassian.net-sdk</Copyright>
    <PackageTags>Atlassian JIRA LINQ</PackageTags>
    <Description>Utilities to interact with Atlassian products. Contains LinqToJira provider for querying JIRA Issue tracker (http://www.atlassian.com/software/jira).</Description>
    <PackageProjectUrl>https://github.com/dzaba1/Atlassian.NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dzaba1/Atlassian.NET</RepositoryUrl>
    <PackageLicenseExpression>BSD-2-Clause</PackageLicenseExpression>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>AtlassianIcon.png</PackageIcon>
    <JiraV3SwaggerFile>$(MSBuildProjectDirectory)\..\contracts\swagger_v3.json</JiraV3SwaggerFile>
    <JiraV3ModelOutputFile>$(MSBuildProjectDirectory)\Model\V3\JiraModelV3.g.cs</JiraV3ModelOutputFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <LangVersion>14</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\AtlassianIcon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Linq.Async" Condition="'$(TargetFramework)' != 'net10.0'" />
    <PackageReference Include="NSwag.MSBuild" PrivateAssets="All" />
    <PackageReference Include="System.ComponentModel.Annotations" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <PackageReference Include="System.Text.Json" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
  </ItemGroup>

  <!-- Off by default: regenerating overwrites manual fixes applied for https://github.com/RicoSuter/NSwag/issues/3738.
       Run `dotnet build Dzaba.AtlassianSdk.Jira.csproj -p:RegenerateJiraModelV3=true` to regenerate;
       see docs/how-to-regenerate-jira-v3-model.md. -->
  <Target Name="GenerateJiraModelV3"
          BeforeTargets="DispatchToInnerBuilds;CoreCompile"
          Condition="'$(RegenerateJiraModelV3)' == 'true'">
    <Exec Command="$(NSwagExe_Net100) openapi2csclient /input:$(JiraV3SwaggerFile) /output:$(JiraV3ModelOutputFile) /namespace:Atlassian.Jira.Model.V3 /TypeAccessModifier:public /GenerateClientClasses:true /GenerateClientInterfaces:true /JsonLibrary:SystemTextJson /GenerateDefaultValues:false" />
  </Target>
</Project>
